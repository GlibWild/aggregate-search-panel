{
  "manifest_version": 3,
  "name": "聚合搜索 · 多站点扫码登录面板",
  "version": "1.0.5",
  "description": "在一个面板中管理多个需要扫码登录的站点，跨站聚合搜索，一键跳转到对应页面，并自动检测登录过期。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "cookies",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开聚合搜索面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
